# Multi-arch Hub pushes (`docker compose -f _push.yml`).
# Admin UI install/build runs on the host CPU. QEMU amd64 on Apple Silicon
# crashes Bun (SIGILL). The Vite dist is portable JS; only the runner Bun is per-arch.
# Local/native builds stay on Dockerfile via _build.yml.
ARG BUILDPLATFORM
ARG TARGETPLATFORM

# --- Vue admin UI (Vite build → copied to /opt/orchestrator/static) ---
FROM --platform=$BUILDPLATFORM node:22-alpine AS admin-ui-build
RUN apk add --no-cache curl bash unzip \
  && curl -fsSL https://bun.com/install | bash \
  && ln -sf /root/.bun/bin/bun /usr/local/bin/bun \
  && bun upgrade --canary
WORKDIR /build
COPY admin-ui ./admin-ui
WORKDIR /build/admin-ui
RUN bun install --frozen-lockfile && bun run build

# --- Orchestrator deps (portable JS; install on host CPU) ---
FROM --platform=$BUILDPLATFORM node:22-alpine AS orchestrator-deps
ENV CI=1
RUN apk add --no-cache curl bash unzip \
  && curl -fsSL https://bun.com/install | bash \
  && ln -sf /root/.bun/bin/bun /usr/local/bin/bun \
  && bun upgrade --canary
WORKDIR /opt/orchestrator
COPY package.json bun.lock tsconfig.json ./
COPY src ./src
RUN bun install --frozen-lockfile

# --- Runtime image (target arch) ---
FROM node:22-alpine

# Environment variables #1
ENV CI=1

# Environment variables #2 (runtime paths)
# /git = cloned Nuxt repo (source)
# /app = served Nitro output (published from /git/.output after build)
# /data = reserved for the Nuxt app
# /var/lib/orchestrator = Docker CI / orchestrator state (volume-mounted)
ENV APP_ROOT="/app"
ENV GITHUB_REPO="/git"
ENV APP_BUILD="/app"
ENV APP_OUTPUT="/app"
ENV ORCHESTRATOR_STATE_DIR="/var/lib/orchestrator"
ENV CURRENT_COMMIT_FILE="${ORCHESTRATOR_STATE_DIR}/current_commit"
ENV LAST_COMMIT_FILE="${ORCHESTRATOR_STATE_DIR}/last_commit"
ENV BUILD_COMPLETE_FLAG="${ORCHESTRATOR_STATE_DIR}/build-complete.flag"
ENV GIT_BRANCH_FILE="${ORCHESTRATOR_STATE_DIR}/git_branch"
ENV PROJECT_BUILD_SCRIPT="/git/scripts/build.sh"

# Admin HTTP (orchestrator dashboard). Use ADMIN_TOKEN when exposing a port.
ENV ADMIN_BIND="0.0.0.0"
ENV ADMIN_PORT="9090"

# git/rsync for clone; wget for healthcheck; curl/bash/unzip for official Bun install
# nodemon watches server entry and runs it via bun
RUN apk add --no-cache git wget rsync curl bash unzip \
  && curl -fsSL https://bun.com/install | bash \
  && ln -sf /root/.bun/bin/bun /usr/local/bin/bun \
  && bun upgrade --canary \
  && npm install -g nodemon

WORKDIR /opt/orchestrator

COPY --from=orchestrator-deps /opt/orchestrator/package.json ./
COPY --from=orchestrator-deps /opt/orchestrator/bun.lock ./
COPY --from=orchestrator-deps /opt/orchestrator/tsconfig.json ./
COPY --from=orchestrator-deps /opt/orchestrator/src ./src
COPY --from=orchestrator-deps /opt/orchestrator/node_modules ./node_modules
COPY --from=admin-ui-build /build/admin-ui/dist ./static

EXPOSE 3000
EXPOSE 9090

CMD ["bun", "run", "start"]
