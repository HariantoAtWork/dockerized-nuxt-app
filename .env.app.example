# =============================================================================
# Application env for the cloned Nuxt app (not the orchestrator)
# =============================================================================
# Compose loads this via env_file and passes it into the container process.
# Add only variables your Nuxt app actually reads (auth, DB, SMTP, etc.).
# Keep Nuxt app data under /data (compose mounts ./data/data → /data).
#
# Orchestrator / Docker settings belong in `.env` — see `.env.example`.
# =============================================================================

NUXT_TELEMETRY_DISABLED=true

# Example placeholders — uncomment and set what your app needs:
# NUXT_PUBLIC_SITE_URL=https://example.com
# DATABASE_URL=file:/data/app.sqlite
