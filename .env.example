# =============================================================================
# Mandatory
# =============================================================================
# Clone URL (may embed a token for private repos)
GITHUB_REPO_URL=

# Used by production compose to pull the image
DOCKER_HUB_IMAGE=harianto/dockerized-nuxt-app:latest

# =============================================================================
# Optional — Docker / ports
# =============================================================================
DOCKER_DEFAULT_PLATFORM=linux/amd64
# NUXT_HOST_PORT=3300
# ADMIN_HOST_PORT=9090

# =============================================================================
# Optional — Git / orchestrator state
# =============================================================================
# Git branch tracked by clone/build/watch (default in image: main)
# GIT_BRANCH=main
# Orchestrator CI state dir (compose: ./data/orchestrator → /var/lib/orchestrator)
# ORCHESTRATOR_STATE_DIR=/var/lib/orchestrator
# GIT_BRANCH_FILE=/var/lib/orchestrator/git_branch

# =============================================================================
# Optional — Runtime paths (defaults match the image; only set to override)
# =============================================================================
# GITHUB_REPO=/git          # clone + build cwd
# APP_ROOT=/app             # serve-related root (usually same as APP_OUTPUT)
# APP_OUTPUT=/app           # nodemon watch + server/index.mjs
# APP_BUILD=/app            # “serve tree complete?” check

# =============================================================================
# Optional — Admin HTTP
# =============================================================================
# Maps to host 127.0.0.1:9090 when compose publishes 9090:9090
# ADMIN_BIND=0.0.0.0
# ADMIN_PORT=9090
# ADMIN_TOKEN=
