# =============================================================================
# Orchestrator / Docker Compose (host `.env`)
# =============================================================================
# Compose uses this file for ${…} substitution and loads it into the container
# (see docker-compose.yml.example env_file). App-only secrets go in `.env.app`.
# =============================================================================

# --- Mandatory ---
# Clone URL (may embed a token for private repos)
GITHUB_REPO_URL=

# Image pulled by compose
DOCKER_HUB_IMAGE=harianto/dockerized-nuxt-app:latest

# --- Optional — host ports (compose only) ---
# NUXT_HOST_PORT=3300
# ADMIN_HOST_PORT=9090

# --- Optional — orchestrator runtime ---
# GIT_BRANCH=main
# ADMIN_TOKEN=
# VERBOSE_LOGGING=true
# WATCH_INTERVAL_MS=60000

# --- Optional — path / state overrides (defaults match the image) ---
# ORCHESTRATOR_STATE_DIR=/var/lib/orchestrator
# GIT_BRANCH_FILE=/var/lib/orchestrator/git_branch
# GITHUB_REPO=/git
# APP_ROOT=/app
# APP_OUTPUT=/app
# APP_BUILD=/app
# ADMIN_BIND=0.0.0.0
# ADMIN_PORT=9090
